# ON-FARM 환경변수 예시 — 이 파일을 .env 로 복사해서 쓰세요.
# 아무것도 설정하지 않아도 서버는 그대로 돕니다(로컬 휴리스틱 판정으로 동작).

# ── 서버 ────────────────────────────────────────────────
PORT=4173
HOST=127.0.0.1

# 세션 쿠키 서명 키. 운영에서는 반드시 바꾸세요.
SESSION_SECRET=onfarm-dev-secret-change-me

# 시연용 자동 로그인.
# true(기본값) : 판매자 사이트(/seller 또는 seller.* 도메인)에 세션 없이 들어오면
#                기본 농민 계정으로 자동 로그인해 로그인 화면을 건너뜁니다.
#                소비자(/shop)·거점(/hub) 화면에는 적용되지 않습니다.
# false        : 기존 로그인 흐름(계정 선택 화면)으로 돌아갑니다.
DEMO_AUTO_LOGIN=true

# 데모 데이터 초기화 API(POST /api/demo/reset) 스위치. ★시연 전용 장치★
# true(기본값) : 모든 화면의 "시연" 메뉴에서 데이터를 초기 상태로 되돌릴 수 있습니다.
#                되돌릴 수 없는 동작이라 본문에 confirm:'RESET' 을 함께 요구합니다.
# false        : 403 을 돌려주고 초기화를 막습니다.
# 운영 서비스에는 있으면 안 되는 기능입니다. 실서비스 배포에서는 반드시 false 로 두세요.
DEMO_RESET_ENABLED=true

# 데이터 저장 위치(기본값: <프로젝트>/data)
# DATA_DIR=C:\onfarm-data

# ── AI Vision Provider ──────────────────────────────────
# heuristic : 외부 API 없이 브라우저에서 뽑은 색·질감 특징으로 규칙 기반 판정 (기본값, 오프라인 동작)
# openai    : OpenAI 이미지 입력 모델 사용
# anthropic : Anthropic Claude 이미지 입력 모델 사용
# mock      : 시연 고정 응답 (항상 '배' 0.91). 화면에 데모 모드 배지가 뜹니다.
AI_PROVIDER=heuristic

# OPENAI_API_KEY=sk-...
# OPENAI_VISION_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_VISION_MODEL=claude-sonnet-5

# 상품 소개문을 LLM으로 쓸지 여부. off면 규칙 기반 템플릿으로 생성합니다.
# (템플릿도 실제 데이터를 채워 문장을 만들며, 없는 사실은 쓰지 않습니다.)
AI_WRITER=template

# 외부 API 타임아웃(ms). 초과하면 자동으로 로컬 휴리스틱으로 폴백합니다.
AI_TIMEOUT_MS=12000
